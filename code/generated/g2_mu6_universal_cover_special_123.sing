LIB "primdec.lib";
ring r=(0,u),(t,v),lp;
poly curve=(35640*u^4*v^4 - 158598*u^4*v^3 + 249381*u^4*v^2 - 165132*u^4*v + 39204*u^4 + 63177*u^3*v^5 - 49344*u^3*v^4 - 278553*u^3*v^3 + 365796*u^3*v^2 - 37554*u^3*v - 56628*u^3 + 33583*u^2*v^6 + 176949*u^2*v^5 - 197190*u^2*v^4 - 258836*u^2*v^3 + 91098*u^2*v^2 + 145530*u^2*v + 20449*u^2 + 5803*u*v^7 + 91836*u*v^6 + 272367*u*v^5 - 99476*u*v^4 - 137943*u*v^3 - 121176*u*v^2 - 23309*u*v + 472*v^8 + 4947*v^7 + 105822*v^6 + 153316*v^5 + 162648*v^4 + 55275*v^3 + 7903*v^2)/35640;
poly fourS=-v^2*(108*u^4 - 1004*u^3*v + 1260*u^2*v^2 - 432*u*v^3 - 221*v^4);
ideal adjusted=curve,t^2+3*fourS;
ideal G=std(adjusted);
list L=minAssGTZ(G);
"ADJUSTED_COVER_VDIM",vdim(G);
"ADJUSTED_COVER_MINASS",size(L);
int i;
for(i=1;i<=size(L);i++){
  ideal H=std(L[i]);
  "ADJUSTED_COVER_ASS",i,vdim(H),size(H);
}
poly relation=L[1][2];
poly rootnum=subst(relation,t,0);
poly rootden=subst(relation,t,1)-rootnum;
poly identity=reduce(rootnum^2+3*rootden^2*fourS,std(curve));
"ROOT_DENOMINATOR",rootden;
"ROOT_NUMERATOR",rootnum;
"ADJUSTED_SQUARE_IDENTITY_REMAINDER",identity;
quit;
