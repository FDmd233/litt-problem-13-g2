LIB "primdec.lib";
ring r=(0,lam,e2,e3,u),(t,z),lp;
poly curve=(e2^6*lam^2*u^2*z^6 + e2^6*lam^2*u*z^6 + e2^6*lam^2*z^6 + 6*e2^5*lam^2*u^3*z^4 - 9*e2^5*lam^2*u*z^4 - 9*e2^5*lam^2*z^5 + 3*e2^5*lam^2*z^4 - 6*e2^4*e3*lam^2*u^3*z^5 - 6*e2^4*e3*lam^2*u^2*z^6 + 9*e2^4*e3*lam^2*u^2*z^5 + 3*e2^4*e3*lam^2*u*z^6 + 3*e2^4*e3*lam^2*z^6 - 3*e2^4*e3*lam^2*z^5 + 9*e2^4*lam^2*u^4*z^2 - 6*e2^4*lam^2*u^3*z^3 - 21*e2^4*lam^2*u^3*z^2 - 24*e2^4*lam^2*u^2*z^3 + 18*e2^4*lam^2*u^2*z^2 - 9*e2^4*lam^2*u*z^4 + 48*e2^4*lam^2*u*z^3 - 9*e2^4*lam^2*u*z^2 + 3*e2^4*lam^2*z^5 + 27*e2^4*lam^2*z^4 - 18*e2^4*lam^2*z^3 + 3*e2^4*lam^2*z^2 - 3*e2^4*lam*z^5 - 18*e2^3*e3*lam^2*u^4*z^3 - 15*e2^3*e3*lam^2*u^3*z^4 + 48*e2^3*e3*lam^2*u^3*z^3 + 27*e2^3*e3*lam^2*u^2*z^4 - 36*e2^3*e3*lam^2*u^2*z^3 - 3*e2^3*e3*lam^2*u*z^6 - 9*e2^3*e3*lam^2*u*z^4 - 3*e2^3*e3*lam^2*z^6 - 3*e2^3*e3*lam^2*z^4 + 6*e2^3*e3*lam^2*z^3 + 3*e2^3*e3*lam*u*z^6 + 3*e2^3*e3*lam*z^6 - 18*e2^3*lam^2*u^4*z + 3*e2^3*lam^2*u^3*z^2 + 42*e2^3*lam^2*u^3*z + 3*e2^3*lam^2*u^3 + 4*e2^3*lam^2*u^2*z^3 + 36*e2^3*lam^2*u^2*z^2 - 27*e2^3*lam^2*u^2*z - 9*e2^3*lam^2*u^2 + 3*e2^3*lam^2*u*z^4 - 8*e2^3*lam^2*u*z^3 - 54*e2^3*lam^2*u*z^2 + 9*e2^3*lam^2*u - 18*e2^3*lam^2*z^4 - 17*e2^3*lam^2*z^3 + 15*e2^3*lam^2*z^2 + 3*e2^3*lam^2*z - 3*e2^3*lam^2 - 4*e2^3*lam*u^2*z^3 - 3*e2^3*lam*u*z^4 + 8*e2^3*lam*u*z^3 + 18*e2^3*lam*z^4 - 10*e2^3*lam*z^3 + 9*e2^2*e3^2*lam^2*u^4*z^4 + 18*e2^2*e3^2*lam^2*u^3*z^5 - 36*e2^2*e3^2*lam^2*u^3*z^4 + 9*e2^2*e3^2*lam^2*u^2*z^6 - 54*e2^2*e3^2*lam^2*u^2*z^5 + 54*e2^2*e3^2*lam^2*u^2*z^4 - 18*e2^2*e3^2*lam^2*u*z^6 + 54*e2^2*e3^2*lam^2*u*z^5 - 36*e2^2*e3^2*lam^2*u*z^4 + 9*e2^2*e3^2*lam^2*z^6 - 18*e2^2*e3^2*lam^2*z^5 + 9*e2^2*e3^2*lam^2*z^4 + 27*e2^2*e3*lam^2*u^4*z^2 + 9*e2^2*e3*lam^2*u^4*z + 18*e2^2*e3*lam^2*u^3*z^3 - 36*e2^2*e3*lam^2*u^3*z^2 - 36*e2^2*e3*lam^2*u^3*z - 9*e2^2*e3*lam^2*u^2*z^4 + 18*e2^2*e3*lam^2*u^2*z^3 - 54*e2^2*e3*lam^2*u^2*z^2 + 54*e2^2*e3*lam^2*u^2*z + 36*e2^2*e3*lam^2*u*z^4 - 90*e2^2*e3*lam^2*u*z^3 + 108*e2^2*e3*lam^2*u*z^2 - 36*e2^2*e3*lam^2*u*z + 9*e2^2*e3*lam^2*z^5 - 27*e2^2*e3*lam^2*z^4 + 54*e2^2*e3*lam^2*z^3 - 45*e2^2*e3*lam^2*z^2 + 9*e2^2*e3*lam^2*z + 9*e2^2*e3*lam*u^2*z^4 - 9*e2^2*e3*lam*u*z^4 - 9*e2^2*e3*lam*z^5 + 9*e2^2*lam^2*u^4 - 12*e2^2*lam^2*u^3*z - 27*e2^2*lam^2*u^3 - 9*e2^2*lam^2*u^2*z^2 - 18*e2^2*lam^2*u^2*z + 36*e2^2*lam^2*u^2 + 18*e2^2*lam^2*u*z^2 + 54*e2^2*lam^2*u*z - 27*e2^2*lam^2*u + 3*e2^2*lam^2*z^4 + 18*e2^2*lam^2*z^3 + 9*e2^2*lam^2*z^2 - 24*e2^2*lam^2*z + 9*e2^2*lam^2 + 12*e2^2*lam*u^3*z + 9*e2^2*lam*u^2*z^2 - 9*e2^2*lam*u^2*z - 18*e2^2*lam*u*z^2 - 6*e2^2*lam*z^4 - 18*e2^2*lam*z^3 + 18*e2^2*lam*z^2 - 3*e2^2*lam*z + 3*e2^2*z^4 - 9*e2*e3^2*lam^2*u^4*z^3 - 9*e2*e3^2*lam^2*u^3*z^4 + 36*e2*e3^2*lam^2*u^3*z^3 + 9*e2*e3^2*lam^2*u^2*z^5 + 27*e2*e3^2*lam^2*u^2*z^4 - 54*e2*e3^2*lam^2*u^2*z^3 + 9*e2*e3^2*lam^2*u*z^6 - 18*e2*e3^2*lam^2*u*z^5 - 27*e2*e3^2*lam^2*u*z^4 + 36*e2*e3^2*lam^2*u*z^3 - 9*e2*e3^2*lam^2*z^6 + 9*e2*e3^2*lam^2*z^5 + 9*e2*e3^2*lam^2*z^4 - 9*e2*e3^2*lam^2*z^3 - 9*e2*e3^2*lam*u^2*z^5 - 9*e2*e3^2*lam*u*z^6 + 18*e2*e3^2*lam*u*z^5 + 9*e2*e3^2*lam*z^6 - 9*e2*e3^2*lam*z^5 - 9*e2*e3*lam^2*u^4*z - 9*e2*e3*lam^2*u^4 + 3*e2*e3*lam^2*u^3*z^2 + 36*e2*e3*lam^2*u^3 + 6*e2*e3*lam^2*u^2*z^3 - 9*e2*e3*lam^2*u^2*z^2 + 54*e2*e3*lam^2*u^2*z - 54*e2*e3*lam^2*u^2 - 9*e2*e3*lam^2*u*z^4 + 24*e2*e3*lam^2*u*z^3 + 9*e2*e3*lam^2*u*z^2 - 72*e2*e3*lam^2*u*z + 36*e2*e3*lam^2*u - 3*e2*e3*lam^2*z^5 + 18*e2*e3*lam^2*z^4 - 30*e2*e3*lam^2*z^3 - 3*e2*e3*lam^2*z^2 + 27*e2*e3*lam^2*z - 9*e2*e3*lam^2 - 12*e2*e3*lam*u^3*z^2 - 6*e2*e3*lam*u^2*z^3 + 9*e2*e3*lam*u^2*z^2 + 9*e2*e3*lam*u*z^4 - 24*e2*e3*lam*u*z^3 + 18*e2*e3*lam*u*z^2 + 6*e2*e3*lam*z^5 - 18*e2*e3*lam*z^4 + 30*e2*e3*lam*z^3 - 15*e2*e3*lam*z^2 - 3*e2*e3*z^5 + 12*e2*lam^2*u^3 + 9*e2*lam^2*u^2*z - 21*e2*lam^2*u^2 - 36*e2*lam^2*u*z + 15*e2*lam^2*u - 3*e2*lam^2*z^3 - 15*e2*lam^2*z^2 + 18*e2*lam^2*z - 6*e2*lam^2 - 12*e2*lam*u^3 - 9*e2*lam*u^2*z + 21*e2*lam*u^2 + 36*e2*lam*u*z - 15*e2*lam*u + 6*e2*lam*z^3 + 12*e2*lam*z^2 - 18*e2*lam*z + 6*e2*lam - 3*e2*z^3 + 3*e2*z^2 - 6*e3^2*lam^2*u^3*z^3 - 9*e3^2*lam^2*u^2*z^4 + 18*e3^2*lam^2*u^2*z^3 + 18*e3^2*lam^2*u*z^4 - 18*e3^2*lam^2*u*z^3 + 3*e3^2*lam^2*z^6 - 9*e3^2*lam^2*z^4 + 6*e3^2*lam^2*z^3 + 6*e3^2*lam*u^3*z^3 + 9*e3^2*lam*u^2*z^4 - 18*e3^2*lam*u^2*z^3 - 18*e3^2*lam*u*z^4 + 18*e3^2*lam*u*z^3 - 6*e3^2*lam*z^6 + 9*e3^2*lam*z^4 - 6*e3^2*lam*z^3 + 3*e3^2*z^6 - 6*e3*lam^2*u^3*z - 6*e3*lam^2*u^3 - 9*e3*lam^2*u^2*z^2 - 9*e3*lam^2*u^2*z + 18*e3*lam^2*u^2 - 6*e3*lam^2*u*z^3 - 9*e3*lam^2*u*z^2 + 36*e3*lam^2*u*z - 18*e3*lam^2*u - 3*e3*lam^2*z^4 + 18*e3*lam^2*z^2 - 21*e3*lam^2*z + 6*e3*lam^2 + 6*e3*lam*u^3*z + 6*e3*lam*u^3 + 9*e3*lam*u^2*z^2 + 9*e3*lam*u^2*z - 18*e3*lam*u^2 + 12*e3*lam*u*z^3 + 9*e3*lam*u*z^2 - 36*e3*lam*u*z + 18*e3*lam*u + 6*e3*lam*z^4 - 18*e3*lam*z^2 + 21*e3*lam*z - 6*e3*lam - 6*e3*u*z^3 - 3*e3*z^4 + 4*lam^2*u^2 + 6*lam^2*u*z - 2*lam^2*u + 3*lam^2*z^2 - 3*lam^2*z + lam^2 - 8*lam*u^2 - 12*lam*u*z + 4*lam*u - 6*lam*z^2 + 6*lam*z - 2*lam + 4*u^2 + 6*u*z - 2*u + 3*z^2 - 3*z + 1)/(9*e2*lam^2*(e2 - e3));
poly fourS=-(-4*e2^3*lam^2*u^3 + 4*e2^3*lam^2 - 9*e2^2*lam^2 + 12*e2*e3*lam^2*u^3 - 18*e2*e3*lam^2*u^2 + 6*e2*e3*lam^2 + 6*e2*lam^2 - 6*e2*lam + 3*e3^2*lam^2*u^4 - 12*e3^2*lam^2*u^3 + 18*e3^2*lam^2*u^2 - 12*e3^2*lam^2*u + 3*e3^2*lam^2 + 6*e3*lam^2*u^2 - 6*e3*lam^2 - 6*e3*lam*u^2 + 6*e3*lam - lam^2 + 2*lam - 1)/lam^2;
ideal adjusted=curve,t^2+3*fourS;
ideal G=std(adjusted);
"ADJUSTED_COVER_VDIM",vdim(G);
list L=minAssGTZ(G);
"ADJUSTED_COVER_MINASS",size(L);
int i;
for(i=1;i<=size(L);i++){
  ideal H=std(L[i]);
  "ADJUSTED_COVER_ASS",i,vdim(H),size(H);
}
poly relation=L[1][2];
poly rootnum=subst(relation,t,0);
poly rootden=subst(relation,t,1)-rootnum;
poly identity=reduce(rootnum^2+3*rootden^2*fourS,std(curve));
"ROOT_DENOMINATOR",rootden;
"ROOT_NUMERATOR",rootnum;
"ADJUSTED_SQUARE_IDENTITY_REMAINDER",identity;
quit;
